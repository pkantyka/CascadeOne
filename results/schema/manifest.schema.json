{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CascadeOne Run Manifest v0.1",
  "type": "object",
  "required": [
    "schema",
    "status",
    "cascade_id",
    "phase",
    "cascade_config_sha256",
    "dataset_sha256",
    "repeats",
    "warmup",
    "models",
    "n_requests",
    "execution",
    "dataset_identity",
    "routing",
    "benchmark_setup",
    "normalized_requests_sha256"
  ],
  "properties": {
    "schema": {
      "const": "cascadeone-run-v0.1"
    },
    "status": {
      "const": "complete"
    },
    "cascade_id": {
      "type": "string",
      "minLength": 1
    },
    "phase": {
      "enum": [
        "colocated",
        "strong-alone"
      ]
    },
    "cascade_config_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "dataset_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "repeats": {
      "type": "integer",
      "minimum": 1
    },
    "warmup": {
      "type": "integer",
      "minimum": 0
    },
    "n_requests": {
      "type": "integer",
      "minimum": 1
    },
    "execution": {
      "enum": [
        "single_client_sequential_http",
        "systemone_inference_proxy_http"
      ]
    },
    "models": {
      "type": "object",
      "required": [
        "fast",
        "strong"
      ]
    },
    "dataset_identity": {
      "type": "object",
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "bundled",
            "downloadable",
            "local_unregistered"
          ]
        },
        "id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "routing": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string"
        },
        "parameters": {
          "type": "object"
        }
      }
    },
    "benchmark_setup": {
      "type": "object",
      "required": [
        "adapter",
        "selection"
      ]
    },
    "normalized_requests_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "engine_version": {
      "type": "string",
      "description": "Present for shared inference proxy runs."
    },
    "inference_url": {
      "type": "string",
      "description": "Logical HTTP location of the inference proxy used by benchmark."
    }
  }
}
